# ===== Поиск в «Полке» =====
# Основной: Яндекс Search API (Yandex Cloud Search API v2).
# Ключ получаем в Yandex Cloud → Сервисные аккаунты → API-ключи.
# ВАЖНО: у сервисного аккаунта должна быть роль `search-api.user`
# на каталоге (folder), где включён Search API.
YANDEX_API_KEY=your-yandex-cloud-api-key
YANDEX_FOLDER_ID=your-yandex-cloud-folder-id
# Ключ должен иметь роль search-api.user в каталоге Yandex Cloud.

# Пример конфигурации; реальные значения храните только в server/.env (не коммитьте).

# Резервный: свой SearXNG инстанс с включённым JSON API.
# Публичные узлы searx.space JSON-режим в большинстве случаев отключают,
# поэтому без своего инстанса резерв не работает.
# SEARX_URL=https://your.searxng.instance

# ===== Опционально: дополнительные поисковые API (не в основном поиске) =====
# GOOGLE_CSE_KEY=
# GOOGLE_CSE_CX=
# BING_SEARCH_KEY=
# BRAVE_SEARCH_KEY=
# YANDEX_XML_USER=
# YANDEX_XML_KEY=
