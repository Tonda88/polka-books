# Настройки сервера «Полки»
# Скопируйте в .env и заполните нужные ключи.
# Файл .env НЕ коммитится в репозиторий (добавлен в .gitignore).

# ---- Google Custom Search (необязательно) ----
# Получить: https://developers.google.com/custom-search/v1/overview
# GOOGLE_CSE_KEY=AIza...
# GOOGLE_CSE_CX=017...

# ---- Яндекс XML API (необязательно) ----
# Получить: https://yandex.ru/dev/xml/
# YANDEX_XML_USER=login
# YANDEX_XML_KEY=key
# YANDEX_XML_LR=213   # регион: 213=Москва, 2=Питер, 0=по умолчанию

# ---- Bing Web Search (необязательно) ----
# Получить: https://azure.microsoft.com/products/ai-services/bing-web-search-api
# BING_SEARCH_KEY=...

# ---- Brave Search API (необязательно) ----
# BRAVE_SEARCH_KEY=...

# ---- SearXNG собственный инстанс (необязательно) ----
# SEARX_URL=https://your.searxng.instance
